{
  "name": "galaxy-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive 2D continuum (self-gravitating fluid) galaxy simulator with and without dark matter, in the browser",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
